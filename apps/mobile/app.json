{
  "expo": {
    "name": "ClinicQ",
    "slug": "communityClinicQ",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "backgroundColor": "#1B6B3A"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.clinicq.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#1B6B3A"
      },
      "package": "com.clinicq.app"
    },
    "plugins": [
      "expo-router",
      "expo-font",
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow ClinicQ to use your location to find nearby clinics."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/icon.png",
          "color": "#1B6B3A"
        }
      ]
    ],
    "scheme": "clinicq",
    "experiments": {
      "typedRoutes": false
    }
  }
}